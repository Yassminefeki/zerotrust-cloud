# --- local environment (machine/network specific) ---
env.yaml

# --- generated from policy.yaml by tools/gen_rules.py ---
build/

# --- secrets: generated by Ansible, NEVER committed ---
ansible/.secrets/
*.key
*.pem
!ansible/roles/**/files/*.pub.pem
wg-*.conf

# --- terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl.bak
crash.log

# --- python ---
.venv/
__pycache__/
.pytest_cache/
*.pyc

# --- test artefacts ---
remote-client-report.json
tests/artifacts/
*.pcap

# --- local Ansible collections cache ---
.ansible/
