#!/usr/bin/env bash
# tools/fetch-image URL CACHE_DIR — download the Ubuntu cloud image ONCE, resumably, and verify it
# against Ubuntu's published SHA256SUMS. Prints the local path on stdout (progress on stderr).
#
# Why not let Terraform download it: the libvirt provider streams the URL straight into the
# pool, shows no progress, cannot resume, and starts from zero after any Wi-Fi hiccup. Here the
# file is kept in CACHE_DIR, so `make destroy && make up` never downloads it again.
set -euo pipefail
url=${1:?usage: fetch-image URL CACHE_DIR}
dir=${2:?usage: fetch-image URL CACHE_DIR}
name=$(basename "$url")
out="$dir/$name"
mkdir -p "$dir"

# Expected checksum: from the SHA256SUMS next to the image; offline, from our last verification.
want=""
if sums=$(curl -fsSL --retry 5 --retry-delay 3 --max-time 60 "$(dirname "$url")/SHA256SUMS"); then
  want=$(printf '%s\n' "$sums" | awk -v n="$name" '$2 == n || $2 == "*" n { print $1 }')
  [ -n "$want" ] || { echo "fetch-image: $name not listed in SHA256SUMS" >&2; exit 1; }
elif [ -s "$out.sha256" ]; then
  want=$(cat "$out.sha256")
  echo "fetch-image: SHA256SUMS unreachable, using the checksum verified last time" >&2
else
  echo "fetch-image: cannot fetch SHA256SUMS and no verified copy yet" >&2
  exit 1
fi

ok() { [ -f "$1" ] && echo "$want  $1" | sha256sum -c --quiet - >/dev/null 2>&1; }

if ok "$out"; then
  echo "fetch-image: $out (cached, sha256 ok)" >&2
  echo "$out"
  exit 0
fi

# A stale/partial file: continue it (a newer upstream image fails the checksum -> fresh retry).
[ -f "$out" ] && mv -f "$out" "$out.part"

download() {
  # Own retry loop: Wi-Fi drops (curl 18/28/56) resume where they stopped; a server that
  # cannot resume (33/36) or a .part longer than the file (416 -> 22) starts over.
  local try rc
  for try in $(seq 1 40); do
    rc=0
    curl -fL -C - --connect-timeout 20 --speed-limit 2048 --speed-time 60 \
         -o "$out.part" "$url" >&2 || rc=$?
    case $rc in
      0) return 0 ;;
      33|36|22) ok "$out.part" && return 0
                echo "fetch-image: cannot resume (curl $rc), restarting from zero" >&2
                rm -f "$out.part" ;;
      *) echo "fetch-image: interrupted (curl $rc), resuming in 5 s ($try/40)" >&2
         sleep 5 ;;
    esac
  done
  return 1
}

for attempt in 1 2; do
  echo "fetch-image: downloading $url (resumable)" >&2
  download || { echo "fetch-image: download kept failing" >&2; exit 1; }
  mv -f "$out.part" "$out"
  if ok "$out"; then
    printf '%s\n' "$want" > "$out.sha256"
    echo "fetch-image: $out (sha256 ok)" >&2
    echo "$out"
    exit 0
  fi
  echo "fetch-image: checksum mismatch, downloading again from scratch" >&2
  rm -f "$out"
done
echo "fetch-image: still a checksum mismatch after a fresh download" >&2
exit 1
