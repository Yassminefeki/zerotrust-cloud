# Stage 2 — networks + VMs on the i5.
# Every value comes from ../build/terraform.tfvars.json, generated by tools/gen_rules.py
# from policy.yaml + env.yaml: no IP is written in this directory.
#
#   make infra      (= terraform init + apply -var-file=../build/terraform.tfvars.json)

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    libvirt = {
      # 0.8.x = stable schema. 0.9.x is a full rewrite whose schema still moves.
      source  = "dmacvicar/libvirt"
      version = "~> 0.8.3"
    }
  }
}

provider "libvirt" {
  uri = var.libvirt_uri
}

# ------------------------------------------------------------------ inputs --
variable "libvirt_uri" { type = string }
variable "pool_name" { type = string }
variable "pool_path" { type = string }
variable "image_url" { type = string }
variable "ssh_user" { type = string }
variable "ssh_public_key_file" { type = string }
variable "apt_proxy" { type = string }

variable "disk_size_bytes" {
  type    = number
  default = 10737418240 # 10 GiB per VM (thin, qcow2 overlay on the base image)
}

variable "vcpu" {
  type    = number
  default = 1
}

variable "networks" {
  type = map(object({
    name    = string
    mode    = string # nat | isolated
    cidr    = string
    bridge  = string
    host_ip = optional(string)
    prefix  = number
  }))

  validation {
    condition     = alltrue([for n in var.networks : contains(["nat", "isolated"], n.mode)])
    error_message = "network mode must be nat or isolated."
  }
  validation {
    # libvirt gives the host the first address of `addresses`
    condition     = alltrue([for n in var.networks : n.host_ip == null || n.host_ip == cidrhost(n.cidr, 1)])
    error_message = "host_ip must be the first host address of the network (libvirt convention)."
  }
  validation {
    condition     = alltrue([for n in var.networks : n.mode == "isolated" || n.host_ip != null])
    error_message = "a nat network needs a host_ip."
  }
}

variable "nodes" {
  type = map(object({
    memory_mb  = number
    ip_forward = bool
    interfaces = list(object({
      network = string
      ip      = string
      iface   = string
      mac     = string
      prefix  = number
      routes  = list(object({ to = string, via = string }))
    }))
  }))
}

locals {
  ssh_public_key = trimspace(file(pathexpand(var.ssh_public_key_file)))
}
