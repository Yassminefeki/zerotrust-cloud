# GENERATED by Ansible (role app) — every minute: a revocation is enforced within ~1 minute
# everywhere (`make revoke` also triggers it at once). zt-mtls refuses everyone if the list
# is older than the CRL's next update (24 h): fail-closed.
[Unit]
Description=Refresh the revocation list every minute

[Timer]
OnBootSec=10s
OnUnitActiveSec=60s
AccuracySec=5s

[Install]
WantedBy=timers.target
