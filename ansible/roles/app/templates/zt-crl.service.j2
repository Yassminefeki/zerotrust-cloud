# GENERATED by Ansible (role app) — revocation list for zt-mtls (stage 13)
[Unit]
Description=Fetch the CA's CRL, check its signature, publish the revoked serials for zt-mtls
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zt-crl /etc/zt/mtls.json
# least privilege: it only writes /etc/zt/pki/revoked.json
ProtectSystem=strict
ReadWritePaths=/etc/zt/pki
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
