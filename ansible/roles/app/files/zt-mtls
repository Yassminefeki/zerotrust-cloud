#!/usr/bin/env python3
"""zt-mtls — the frontend proxy and service-a/b: one small mTLS service, configured by the
mtls.json that tools/gen_rules.py generates from policy.yaml.

Server side, for every listener in "serves":
  * TLS 1.3 only, client certificate REQUIRED and verified against the pinned root
    (no cert / other CA / expired cert -> the handshake fails);
  * then the caller's SPIFFE ID (URI SAN) must be in allowed_ids and its address in
    allowed_sources, otherwise 403. Every refusal is logged ("zt-mtls refused ...").
Client side, for every entry in "calls":
  * TLS 1.3 only, own certificate presented, server verified against the root AND its IP SAN,
    AND its SPIFFE ID must equal expected_id before any byte of the request is sent;
  * protocol "postgres": libpq (psycopg2) with sslmode=verify-full + client certificate.

Then the request itself must match one of the listener's `routes` (generated from the policy):
  * no route with that method + path -> 404; a route that is not open to this caller -> 403.
  * a listener without routes serves nothing (default deny).

Then, per identity (the actor directory of mtls.json):
  * `sources`: the identity is valid only from these addresses (a certificate bound to a device);
  * `rate_per_min`: token bucket per identity; beyond it 429 + Retry-After, logged once per burst.

Routes implemented here: GET /health, GET /chain?marker=X (this hop + the next hops, down to the
database), GET /api/me (who the caller is: actor, role, customer). Others answer 501 until their
stage is deployed.
"""
import http.client
import ipaddress
import json
import logging
import os
import socket
import ssl
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, quote, urlparse

CONF_PATH = sys.argv[1] if len(sys.argv) > 1 else "/etc/zt/mtls.json"
PKI = sys.argv[2] if len(sys.argv) > 2 else "/etc/zt/pki"
CERT, KEY, ROOT = f"{PKI}/cert.crt", f"{PKI}/cert.key", f"{PKI}/root_ca.crt"
CONF = json.load(open(CONF_PATH))
TLS13 = ssl.TLSVersion.TLSv1_3
assert CONF.get("min_tls") == "1.3", "this service only implements TLS 1.3"

logging.basicConfig(level=logging.INFO, format="zt-mtls %(message)s", stream=sys.stdout)
log = logging.getLogger()

# The bank application (zt_bank.py) lives next to this program, or in /usr/local/lib/zt.
sys.path[1:1] = [os.path.dirname(os.path.realpath(__file__)), "/usr/local/lib/zt"]
try:
    import zt_bank
except ImportError:          # transport/identity only (no `app` on any listener)
    zt_bank = None
MAX_BODY = 8192
SECURITY_HEADERS = {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; "
                               "connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Strict-Transport-Security": "max-age=31536000",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
}


class RateLimiter:
    """Token bucket per identity: `per_min` tokens, refilled continuously (burst = per_min)."""

    def __init__(self):
        self.buckets, self.lock = {}, threading.Lock()

    def take(self, ident, per_min):
        """-> 0 if allowed, else the seconds to wait before the next request."""
        now = time.monotonic()
        with self.lock:
            tokens, last = self.buckets.get(ident, (float(per_min), now))
            tokens = min(float(per_min), tokens + (now - last) * per_min / 60.0)
            if tokens >= 1:
                self.buckets[ident] = (tokens - 1, now)
                return 0
            self.buckets[ident] = (tokens, now)
            return max(1, int((1 - tokens) * 60.0 / per_min + 0.999))


LIMITER = RateLimiter()
THROTTLED = set()          # identities currently refused (log the start of a burst only)


def spiffe_ids(peercert):
    return [v for k, v in (peercert or {}).get("subjectAltName", ()) if k == "URI"]


def route_match(pattern, path):
    """`*` matches exactly one path segment; everything else must be equal."""
    p, q = pattern.strip("/").split("/"), path.strip("/").split("/")
    return len(p) == len(q) and all(a == "*" or a == b for a, b in zip(p, q))


def find_route(listener, method, path):
    """The route matching method + path, or None (-> 404)."""
    for r in listener.get("routes", []):
        if r["method"] == method and route_match(r["path"], path):
            return r
    return None


def server_context():
    c = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    c.minimum_version = c.maximum_version = TLS13
    c.load_cert_chain(CERT, KEY)
    c.load_verify_locations(ROOT)
    c.verify_mode = ssl.CERT_REQUIRED
    return c


def client_context():
    c = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)        # CERT_REQUIRED + check_hostname
    c.minimum_version = c.maximum_version = TLS13
    c.load_verify_locations(ROOT)
    c.load_cert_chain(CERT, KEY)
    return c


# ----------------------------------------------------------------- client --
def call_https(name, path):
    spec = CONF["calls"][name]
    host, port = spec["address"].rsplit(":", 1)
    conn = http.client.HTTPSConnection(host, int(port), context=client_context(), timeout=10)
    try:
        conn.connect()
        ids = spiffe_ids(conn.sock.getpeercert())
        if ids != [spec["expected_id"]]:
            raise PermissionError(f"{spec['address']} presented {ids}, expected {spec['expected_id']}")
        conn.request("GET", path)
        r = conn.getresponse()
        body = r.read()
        if r.status != 200:
            raise RuntimeError(f"{name} answered {r.status}: {body[:200]!r}")
        return json.loads(body)
    finally:
        conn.close()


def upstream_https():
    return next((n for n, c in CONF["calls"].items() if c.get("protocol", "https") == "https"), None)


def call_api(method, path, body=None, headers=None):
    """The next hop of the bank, with the same pinning as call_https. -> (status, json)."""
    name = upstream_https()
    if name is None:
        raise RuntimeError("this node calls no HTTPS service")
    spec = CONF["calls"][name]
    host, port = spec["address"].rsplit(":", 1)
    conn = http.client.HTTPSConnection(host, int(port), context=client_context(), timeout=15)
    try:
        conn.connect()
        ids = spiffe_ids(conn.sock.getpeercert())
        if ids != [spec["expected_id"]]:
            raise PermissionError(f"{spec['address']} presented {ids}, expected {spec['expected_id']}")
        data = json.dumps(body).encode() if body is not None else None
        h = dict(headers or {})
        if data is not None:
            h["Content-Type"] = "application/json"
        conn.request(method, path, body=data, headers=h)
        r = conn.getresponse()
        raw = r.read()
        try:
            return r.status, json.loads(raw or b"{}")
        except ValueError:
            return 502, {"error": f"{name} answered non-JSON"}
    finally:
        conn.close()


def db_connect():
    import psycopg2   # only the node that calls the database needs it
    name = next(n for n, c in CONF["calls"].items() if c.get("protocol") == "postgres")
    spec = CONF["calls"][name]
    host, port = spec["address"].rsplit(":", 1)
    return psycopg2.connect(host=host, port=int(port), dbname=spec["db_name"], user=spec["db_user"],
                            sslmode="verify-full", sslrootcert=ROOT, sslcert=CERT, sslkey=KEY,
                            ssl_min_protocol_version="TLSv1.3", connect_timeout=5)


def db_query(customer, sql, args=(), write=False):
    """One transaction. `customer` is set as zt.customer for THIS transaction only: the row-level
    security of the database then returns that customer's rows and nothing else."""
    import psycopg2
    conn = db_connect()
    try:
        with conn, conn.cursor() as cur:
            if customer is not None:
                cur.execute("SELECT set_config('zt.customer', %s, true)", (customer,))
            cur.execute(sql, args)
            return cur.fetchall()
    except psycopg2.Error as e:
        raise zt_bank.pg_error_to_reply(e)
    finally:
        conn.close()


class Tools:
    """What the bank application may use: the next hop, the database, the log, the limits."""
    api = staticmethod(call_api)
    db = staticmethod(db_query)
    log = staticmethod(lambda msg: log.info("%s", msg))
    bank = CONF.get("bank", {})


class Request:
    def __init__(self, handler, method, url, raw):
        self.method, self.path = method, url.path
        self.query = {k: v[0] for k, v in parse_qs(url.query).items()}
        # only the identity headers set by the upstream node are ever read by the app
        # canonical names (X-ZT-Actor, X-ZT-Role, X-ZT-Customer), whatever case the sender used
        self.headers = {"-".join("ZT" if w.lower() == "zt" else w.capitalize() for w in k.split("-")): v
                        for k, v in handler.headers.items() if k.lower().startswith("x-zt-")}
        # what a browser says about where a request comes from (cross-site request forgery checks)
        self.browser = {k: handler.headers.get(k, "") for k in ("Content-Type", "Origin", "Host", "Sec-Fetch-Site")}
        self.raw = raw
        self.listener = handler.listener
        self.peer_id, self.actor, self.route = handler.peer_id, handler.actor, handler.route["name"]

    def json(self):
        return zt_bank.parse_json(self.raw)


def call_postgres(name, marker):
    import psycopg2   # only the node that calls the database needs it
    spec = CONF["calls"][name]
    host, port = spec["address"].rsplit(":", 1)
    conn = psycopg2.connect(host=host, port=int(port), dbname=spec["db_name"], user=spec["db_user"],
                            sslmode="verify-full", sslrootcert=ROOT, sslcert=CERT, sslkey=KEY,
                            ssl_min_protocol_version="TLSv1.3", connect_timeout=5)
    try:
        with conn.cursor() as cur:
            cur.execute("""SELECT current_user, %s::text,
                                  (bank.status()->>'ledger_balanced')::boolean,
                                  s.version, s.client_dn
                           FROM pg_stat_ssl s WHERE s.pid = pg_backend_pid()""", (marker,))
            user, echo, balanced, version, client_dn = cur.fetchone()
        return {"node": "database", "db_user": user, "marker": echo, "ledger_balanced": balanced,
                "tls": version, "client_dn": client_dn}
    finally:
        conn.close()


def next_hop(marker):
    for name, spec in CONF["calls"].items():
        if spec.get("protocol") == "postgres":
            return call_postgres(name, marker)
        return call_https(name, f"/chain?marker={quote(marker)}")
    return None


# ----------------------------------------------------------------- server --
class Handler(BaseHTTPRequestHandler):
    server_version = "zt-mtls"
    sys_version = ""
    listener = None    # set per server

    def setup(self):
        self.peer_id = None
        self.request.settimeout(10)
        try:
            self.request.do_handshake()
        except (ssl.SSLError, OSError) as e:
            log.info("refused %s: tls handshake: %s", self.client_address[0], e)
            raise ConnectionAbortedError from e
        super().setup()

    def log_message(self, fmt, *args):
        log.info("%s %s %s", self.client_address[0], self.peer_id, fmt % args)

    def _send(self, code, obj, headers=None):
        if isinstance(obj, tuple) and obj and obj[0] == "raw":
            _, ctype, body = obj
            cache = "no-cache"
        else:
            ctype, body, cache = "application/json", (json.dumps(obj) + "\n").encode(), "no-store"
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", cache)
        for k, v in SECURITY_HEADERS.items():
            self.send_header(k, v)
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        n = self.headers.get("Content-Length")
        if not n:
            return b""
        if not n.isdigit() or int(n) > MAX_BODY:
            self._send(413, {"error": f"body above {MAX_BODY} bytes"})
            return None
        return self.rfile.read(int(n))

    def authorize(self, method, path):
        ids = spiffe_ids(self.request.getpeercert())
        self.peer_id = ids[0] if len(ids) == 1 else None
        self.actor = CONF.get("actors", {}).get(self.peer_id, {})
        self.route = None
        src = ipaddress.ip_address(self.client_address[0])
        code = 403
        if not any(src in ipaddress.ip_network(n) for n in self.listener["allowed_sources"]):
            reason = f"source {src} not allowed"
        elif self.peer_id not in self.listener["allowed_ids"]:
            reason = f"identity {ids} not allowed"
        elif "sources" in self.actor and not any(src in ipaddress.ip_network(n) for n in self.actor["sources"]):
            # a stolen certificate is useless away from the device it was issued for
            reason = f"identity {self.peer_id} not allowed from {src} (bound to {', '.join(self.actor['sources'])})"
        elif self.actor.get("rate_per_min") and (wait := LIMITER.take(self.peer_id, self.actor["rate_per_min"])):
            if self.peer_id not in THROTTLED:
                THROTTLED.add(self.peer_id)
                log.info("rate-limited %s: above %s requests/min, retry after %ss",
                         self.peer_id, self.actor["rate_per_min"], wait)
            self._send(429, {"error": "too many requests", "retry_after": wait}, {"Retry-After": str(wait)})
            return False
        else:
            THROTTLED.discard(self.peer_id)
            route = find_route(self.listener, method, path)
            if route is None:
                code, reason = 404, f"no route {method} {path}"
            elif self.peer_id not in route["allow_ids"]:
                reason = f"route {route['name']} ({method} {route['path']}) not allowed for {self.peer_id}"
            else:
                self.route = route
                return True
        log.info("refused %s: %s", src, reason)
        self._send(code, {"error": "forbidden" if code == 403 else "not found", "reason": reason})
        return False

    def do_POST(self):
        self.do_GET(method="POST")

    def do_PUT(self):
        self.do_GET(method="PUT")

    def do_PATCH(self):
        self.do_GET(method="PATCH")

    def do_DELETE(self):
        self.do_GET(method="DELETE")

    def do_GET(self, method="GET"):
        url = urlparse(self.path)
        if not self.authorize(method, url.path):
            return
        raw = self._body()
        if raw is None:
            return
        me = {"node": CONF["node"], "identity": CONF["identity"], "peer": self.peer_id,
              "tls": self.request.version()}
        name = self.route["name"]
        if name == "whoami":
            return self._send(200, {"identity": self.peer_id, **self.actor, "tls": self.request.version()})
        if name == "health":
            return self._send(200, me)
        if name != "diag-chain" and self.listener.get("app") and zt_bank:
            try:
                status, body = zt_bank.handle(self.listener["app"], Request(self, method, url, raw), Tools)
            except Exception as e:     # never leak a traceback to the caller
                log.exception("app error on %s %s: %s", method, url.path, e)
                status, body = 500, {"error": "internal error"}
            return self._send(status, body)
        if name == "diag-chain":
            marker = parse_qs(url.query).get("marker", [""])[0]
            try:
                me.update(marker=marker, next=next_hop(marker))
            except Exception as e:     # report which hop failed, never hang
                log.info("downstream error: %s", e)
                return self._send(502, dict(me, error=f"{type(e).__name__}: {e}"))
            return self._send(200, me)
        # allowed by the policy but not deployed yet on this node
        return self._send(501, {"error": "not implemented", "route": self.route["name"]})


class Server(ThreadingHTTPServer):
    daemon_threads = True
    request_queue_size = 128     # listen backlog (socketserver's default of 5 drops bursts of clients)

    def __init__(self, listener):
        host, port = listener["listen"].rsplit(":", 1)
        handler = type("H", (Handler,), {"listener": listener})
        super().__init__((host, int(port)), handler, bind_and_activate=False)
        self.socket = server_context().wrap_socket(self.socket, server_side=True,
                                                   do_handshake_on_connect=False)
        self.allow_reuse_address = True
        self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.server_bind()
        self.server_activate()

    def handle_error(self, request, client_address):
        if isinstance(sys.exc_info()[1], (ConnectionAbortedError, ConnectionResetError, BrokenPipeError)):
            return
        super().handle_error(request, client_address)


def main():
    https = {n: l for n, l in CONF["serves"].items() if l.get("protocol", "https") == "https"}
    if not https:
        sys.exit("nothing to serve")
    servers = [Server(l) for l in https.values()]
    for n, l in https.items():
        log.info("serving %s on %s as %s, allowed %s", n, l["listen"], CONF["identity"], l["allowed_ids"])
    for s in servers[1:]:
        threading.Thread(target=s.serve_forever, daemon=True).start()
    servers[0].serve_forever()


if __name__ == "__main__":
    main()
